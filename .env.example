# ============================================
# SQLAgent 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ── LLM API 配置 (默认 DeepSeek, 兼容 OpenAI/Ollama) ──
# API Key: DEEPSEEK_API_KEY 优先, 也可用 OPENAI_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 其他兼容提供商可选:
# OPENAI_API_KEY=sk-your-openai-key  (仅在不使用 DeepSeek 时需要)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── MySQL 数据库配置 ────────────────────────────
# Docker Compose 内: MYSQL_HOST=mysql
# 本地开发: MYSQL_HOST=localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=sqlagent

# ── 应用配置 ────────────────────────────────────
LOG_LEVEL=INFO
READ_ONLY=true
MAX_HISTORY=100
