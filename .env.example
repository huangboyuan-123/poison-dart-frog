# ============================================
# SQLAgent 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ── LLM API 配置 (OpenAI 兼容接口) ──────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── MySQL 数据库配置 ────────────────────────────
# Docker Compose 内: MYSQL_HOST=mysql
# 本地开发: MYSQL_HOST=localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=sqlagent

# ── 应用配置 ────────────────────────────────────
LOG_LEVEL=INFO
READ_ONLY=true
MAX_HISTORY=100
